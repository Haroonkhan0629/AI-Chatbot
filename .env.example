# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real keys.

# Groq LLM API key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Database URL.
# Local dev  →  SQLite, no setup needed:
DATABASE_URL=sqlite:///./local_vectors.db
# Netlify    →  replace with your Neon / Supabase PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@host/dbname

# HuggingFace Inference API token (only needed on Netlify — local dev uses
# sentence-transformers directly and never calls the HuggingFace API).
# Free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here
